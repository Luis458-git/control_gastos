# Puerto en el que escuchará el servidor Puma
PORT=4567

# Entorno de ejecución (development en local, production en Render)
RACK_ENV=development

# Conexión a la base de datos:
# - En local: se puede omitir o indicar la ruta SQLite (db/gastos.sqlite3)
# - En Render: pega la URL de PostgreSQL interna generada en el dashboard
# Ejemplo:
# DATABASE_URL=postgres://usuario:password@host.render.com:5432/nombre_db
DATABASE_URL=sqlite3://db/gastos.sqlite3
