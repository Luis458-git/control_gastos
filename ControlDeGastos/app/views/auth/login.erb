<!-- PANTALLA DE INICIO DE SESIÓN (Estilo Editorial Split Mercury / Wise) -->
<div class="auth-split-wrapper animate-stagger-1">
  <!-- Panel izquierdo: Tarjeta de acceso -->
  <section class="transfer-card auth-card" aria-labelledby="login-title">
    <div class="auth-card-header">
      <span class="eyebrow-label">ACCESO SEGURO</span>
      <h1 id="login-title" class="editorial-title">Iniciar sesión</h1>
      <p class="transfer-card-subtitle">Entra a tu libro financiero personal o prueba la cuenta interactiva.</p>
    </div>

    <% if @error %>
      <div class="alert-box" role="alert">
        <p class="alert-title">No pudimos iniciar sesión</p>
        <p><%= h(@error) %></p>
      </div>
    <% end %>

    <!-- Acceso instantáneo con Cuenta Demo en 1 clic -->
    <form action="/demo" method="post" class="demo-Quick-form">
      <button type="submit" class="btn-lime-full">
        <span>⚡ Entrar con Cuenta Demo (Valeria Montes)</span>
        <span class="btn-arrow">→</span>
      </button>
    </form>

    <div class="auth-divider">
      <span>o con tu correo electrónico</span>
    </div>

    <form action="/login" method="post" class="wt-form">
      <div class="wt-field">
        <label for="login-email" class="wt-label">Correo electrónico</label>
        <input
          type="email"
          id="login-email"
          name="email"
          class="wt-input"
          placeholder="demo@wespend.app"
          value="<%= h(@email_intento || 'demo@wespend.app') %>"
          required
        >
      </div>

      <div class="wt-field">
        <label for="login-password" class="wt-label">Contraseña</label>
        <input
          type="password"
          id="login-password"
          name="password"
          class="wt-input"
          placeholder="••••••••"
          value="demo1234"
          required
        >
      </div>

      <button type="submit" class="wt-btn-primary">
        Acceder al Panel ↗
      </button>
    </form>

    <div class="auth-footer-note">
      <span>¿Aún no tienes cuenta?</span>
      <a href="/registro" class="wt-link-action">Crear una cuenta nueva →</a>
    </div>
  </section>

  <!-- Panel derecho: Tarjeta editorial de credenciales Demo -->
  <aside class="obsidian-showcase-card auth-side-panel animate-stagger-2">
    <span class="showcase-live-pill">
      <span class="pulse-lime"></span> Credenciales de prueba listas
    </span>

    <h2 class="auth-side-title">Explora todas las métricas sin configurar nada.</h2>
    <p class="auth-side-text">
      Hemos pre-cargado una cuenta demostrativa con movimientos de varios meses, métodos de pago y meta de presupuesto mensual para que pruebes los filtros y gráficas animadas al instante.
    </p>

    <div class="demo-credentials-box">
      <div class="cred-row">
        <span class="cred-label">CORREO DEMO</span>
        <code class="cred-val">demo@wespend.app</code>
      </div>
      <div class="cred-row">
        <span class="cred-label">CONTRASEÑA</span>
        <code class="cred-val">demo1234</code>
      </div>
      <div class="cred-row">
        <span class="cred-label">PRESUPUESTO META</span>
        <code class="cred-val tabular-nums">$1,200.00 / mes</code>
      </div>
    </div>
  </aside>
</div>
