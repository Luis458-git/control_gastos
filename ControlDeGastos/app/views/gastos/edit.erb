<div class="edit-screen-wrapper animate-stagger-1">
  <section class="transfer-card edit-focus-card" aria-labelledby="edit-card-title">
    <div class="edit-card-top">
      <a href="/?mes=<%= h(Gasto.normalizar_mes(@gasto.mes)) %>" class="back-pill-link">← Volver al libro</a>
      <span class="record-id-pill tabular-nums">REGISTRO #<%= @gasto.id %></span>
    </div>

    <div class="transfer-card-header">
      <div>
        <h1 id="edit-card-title" class="editorial-title-sm">Editar movimiento</h1>
        <p class="transfer-card-subtitle">Actualiza el importe, categoría o método de pago</p>
      </div>
    </div>

    <% if @gasto.errors.any? %>
      <div class="alert-box" role="alert">
        <p class="alert-title">No se pudo actualizar el gasto:</p>
        <ul class="alert-list">
          <% @gasto.errors.each do |error| %>
            <li><%= h(error) %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <form action="/gastos/<%= @gasto.id %>" method="post" class="wt-form" novalidate>
      <input type="hidden" name="_method" value="PATCH">

      <div class="wt-field">
        <label for="edit-descripcion" class="wt-label">Concepto o comercio</label>
        <input type="text" id="edit-descripcion" name="descripcion" class="wt-input"
               maxlength="180" value="<%= h(@gasto.descripcion) %>" required>
      </div>

      <div class="wt-field-row">
        <div class="wt-field">
          <label for="edit-monto" class="wt-label">Monto ($)</label>
          <input type="number" id="edit-monto" name="monto" class="wt-input tabular-nums"
                 step="0.01" min="0.01" value="<%= h(monto_input(@gasto)) %>" required>
        </div>
        <div class="wt-field">
          <label for="edit-fecha" class="wt-label">Fecha</label>
          <input type="date" id="edit-fecha" name="fecha" class="wt-input tabular-nums"
                 value="<%= h(@gasto.fecha) %>" required>
        </div>
      </div>

      <div class="wt-field-row">
        <div class="wt-field">
          <label for="edit-categoria" class="wt-label">Categoría</label>
          <select id="edit-categoria" name="categoria" class="wt-select" required>
            <% Gasto::CATEGORIAS.each do |categoria| %>
              <option value="<%= h(categoria) %>" <%= 'selected' if @gasto.categoria == categoria %>><%= h(categoria) %></option>
            <% end %>
          </select>
        </div>

        <div class="wt-field">
          <label for="edit-metodo" class="wt-label">Método de pago</label>
          <select id="edit-metodo" name="metodo_pago" class="wt-select">
            <% Gasto::METODOS_PAGO.each do |metodo| %>
              <option value="<%= h(metodo) %>" <%= 'selected' if @gasto.metodo_pago == metodo %>><%= h(metodo) %></option>
            <% end %>
          </select>
        </div>
      </div>

      <div class="edit-metadata-row">
        <span class="wt-label">Fecha de creación:</span>
        <span class="tabular-nums"><%= h(@gasto.created_at) %></span>
      </div>

      <div class="edit-actions-row">
        <a href="/?mes=<%= h(Gasto.normalizar_mes(@gasto.mes)) %>" class="wt-btn-secondary">Cancelar</a>
        <button type="submit" class="btn-lime-full">Guardar cambios ↗</button>
      </div>
    </form>
  </section>
</div>
